# ==============================================================================
# NPad — Apache configuration
# ==============================================================================

# index.php is the single entry point. Without this Apache's default order
# served a stale index.html ahead of it.
DirectoryIndex index.php

Options -Indexes
ServerSignature Off

ErrorDocument 404 /404.php

# ------------------------------------------------------------------------------
# Protected files
# ------------------------------------------------------------------------------

<FilesMatch "^(config\.php|composer\.(json|lock)|package(-lock)?\.json|\.editorconfig|\.gitattributes)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|sql|sqlite|bak|old|backup|ini|md)$">
    Require all denied
</FilesMatch>

# Dotfiles (.git, .env, .htaccess itself)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Source directories are never requested directly. The partials also guard
# themselves in PHP, but blocking at the server is the cheaper first line.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|lang|tests)/ - [F,L]
</IfModule>

# ------------------------------------------------------------------------------
# HTTPS + canonical host
# ------------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never rewrite the ACME challenge path.
    RewriteRule ^\.well-known/ - [L]

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.npad\.ir$ [NC]
    RewriteRule ^(.*)$ https://npad.ir/$1 [L,R=301]

    # Sitemap is generated so lastmod stays accurate.
    RewriteRule ^sitemap\.xml$ /sitemap.php [L]

    # Retire the old flat URLs.
    RewriteRule ^index\.html$ / [L,R=301]
    RewriteRule ^track\.php$ /api/track.php [L,R=301]
    RewriteRule ^dashboard\.php$ /admin/dashboard.php [L,R=301]
    RewriteRule ^export\.php$ /admin/export.php [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# Security headers
# ------------------------------------------------------------------------------

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

    # frame-ancestors supersedes X-Frame-Options. X-XSS-Protection is
    # deprecated and actively harmful in some browsers, so it is not set.
    #
    # Everything now loads from this origin: fonts are self-hosted, icons are
    # inline SVG, and there are no CDN dependencies. The previous policy set
    # connect-src 'self' while the page called three third-party geo-IP APIs,
    # so its own feature was permanently blocked.
    #
    # 'unsafe-inline' in script-src covers the single pre-paint theme script;
    # all other JavaScript is external. There are no inline event handlers.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'"

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
# Compression
# ------------------------------------------------------------------------------

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/manifest+json
</IfModule>

# ------------------------------------------------------------------------------
# Caching
# ------------------------------------------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"

    # Fonts are content-addressed by filename.
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"

    # CSS/JS deliberately short: ES module imports are not cache-busted.
    # The Cache-Control headers below are authoritative; these match them so
    # the two modules cannot disagree.
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"

    # HTML must revalidate so deploys are picked up immediately.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Fonts and vendored libraries carry their version in the filename, so a
    # new release is a new URL. Safe to freeze for a year.
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Our own CSS/JS keeps a stable filename. The <link>/<script> URLs are
    # cache-busted with ?v=filemtime, but ES module imports inside app.js
    # ("./editor.js" etc.) are NOT — the browser resolves those bare. Marking
    # them immutable would pin visitors to a stale module forever after a
    # deploy. must-revalidate keeps them cached but re-checked, which costs a
    # conditional request and returns 304 in the common case.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # Third-party bundles are version-pinned by path and never edited.
    <FilesMatch "^(chart\.umd\.min\.js|prism-1\.30\.0\.min\.js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # The service worker must never be served stale, or clients pin to an
    # old build indefinitely.
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>

# ------------------------------------------------------------------------------
# NOTE ON php_value
#
# The previous .htaccess set php_value/php_flag directives here. Those are
# mod_php-only: under PHP-FPM or CGI (the common setup on shared hosting)
# Apache treats them as unknown and returns HTTP 500 for the whole site.
# Configure these in php.ini or a .user.ini instead:
#
#   upload_max_filesize = 5M
#   post_max_size = 5M
#   session.cookie_httponly = 1
#   session.cookie_secure = 1
#   session.use_strict_mode = 1
#   expose_php = Off
# ------------------------------------------------------------------------------
